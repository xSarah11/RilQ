# Copy this file to .env.local and put your real key there.
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: choose a Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# NASA data needs NO API key: NASA Trek tiles, the NASA Image and Video Library
# and the Mars 2020 traverse GeoJSON are all public.
# Optional (testing only): point the server at another host instead of NASA.
# NASA_IMAGES_API_BASE=https://images-api.nasa.gov
# NASA_MMGIS_BASE=https://mars.nasa.gov/mmgis-maps
# NASA_TREK_BASE=https://trek.nasa.gov/tiles
