# Copy this file to .env.local and put your real keys there. Never commit .env.local.

# ── Chatbot (Google Gemini) ─────────────────────────────────────────────
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: choose a Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# ── NASA Open APIs (api.nasa.gov) ───────────────────────────────────────
# Used for the "NASA Picture of the Day" (APOD). Free, instant: https://api.nasa.gov  → "Generate API Key"
# Without it the site falls back to the public DEMO_KEY (only ~30 requests/hour, 50/day per IP).
# Server-only: it is NOT prefixed with NEXT_PUBLIC_, so it never reaches the browser.
NASA_API_KEY=your-nasa-key-here

# Map tiles (NASA Trek) and the NASA Image and Video Library need no key.
